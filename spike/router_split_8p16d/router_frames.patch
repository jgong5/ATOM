+/// Diagnostic only (COMPASS_TRACE_DIR): a line per stamp, the wall time,
+/// the event and the LP, to <dir>/<pid>.trace, as frames.patch stamps the
+/// Python LPs' clock frames: S as a frame goes out, R as one comes in.
+pub struct Trace(Option<(std::fs::File, String)>);
+
+impl Trace {
+    fn open(lp: &str) -> Self {
+        let dir = std::env::var("COMPASS_TRACE_DIR").ok();
+        let path = dir.map(|d| format!("{d}/{}.trace", std::process::id()));
+        let file = path.and_then(|p| {
+            let mut options = std::fs::OpenOptions::new();
+            options.create(true).append(true).open(p).ok()
+        });
+        Self(file.map(|f| (f, lp.to_owned())))
+    }
+
+    /// Writes one line, `<unix seconds> <event> <lp>`, in one write.
+    pub fn stamp(&mut self, event: &str) {
+        if let Some((file, lp)) = self.0.as_mut() {
+            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH);
+            let line = format!("{:.6} {event} {lp}\n", now.unwrap_or_default().as_secs_f64());
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
