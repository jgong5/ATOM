+class _Trace:
+    """Diagnostic only (COMPASS_TRACE_DIR): one line per frame sent or received,
+    with time.time(), to <dir>/<pid>.trace."""
+
+    def __init__(self, tag):
+        import os as _os
+        import time as _time
+        d = _os.environ.get("COMPASS_TRACE_DIR")
+        self.f = None
+        if d:
+            self.f = open(f"{d}/{_os.getpid()}.trace", "a", buffering=1)
+            self.t = _time.time
+            self.tag = tag
+
+    def __call__(self, ev, extra=""):
+        if self.f is not None:
+            self.f.write(f"{self.t():.6f} {ev} {self.tag} {extra}\n")
+
