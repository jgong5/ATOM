+class _WallProfile:
+    """Diagnostic only (COMPASS_CA_PROFILE=path): per address, wall seconds
+    running (between its reply and its next request) and running alone, while
+    every other bound address waits; written every 10 wall seconds."""
+
+    def __init__(self, path, authority):
+        import json as _json
+        import time as _time
+        self._json, self._time, self._path, self._auth = _json, _time, path, authority
+        self.t0 = self.last = self.flushed = _time.monotonic()
+        self.running = set()
+        self.run_s, self.alone_s, self.reqs = {}, {}, {}
+        self.none_s = 0.0
+        self.serve_s = 0.0
+
+    def _tick(self):
+        now = self._time.monotonic()
+        dt, self.last = now - self.last, now
+        for a in self.running:
+            self.run_s[a] = self.run_s.get(a, 0.0) + dt
+        if len(self.running) == 1:
+            (a,) = self.running
+            self.alone_s[a] = self.alone_s.get(a, 0.0) + dt
+        elif not self.running:
+            self.none_s += dt
+        return now
+
+    def request(self, address):
+        self._tick()
+        a = str(address)
+        self.running.discard(a)
+        self.reqs[a] = self.reqs.get(a, 0) + 1
+
+    def reply(self, address):
+        self._tick()
+        self.running.add(str(address))
+
+    def maybe_flush(self, served_s):
+        self.serve_s += served_s
+        now = self._time.monotonic()
+        if now - self.flushed < 10:
+            return
+        self.flushed = now
+        clocks = sorted(v for v in self._auth._now.values() if v < float("inf"))
+        line = {
+            "wall": now - self.t0,
+            "unix": self._time.time(),
+            "virtual_min": clocks[0] if clocks else None,
+            "virtual_max": clocks[-1] if clocks else None,
+            "serve_s": self.serve_s,
+            "none_s": self.none_s,
+            "running_now": sorted(self.running),
+            "alone_s": dict(sorted(self.alone_s.items(), key=lambda kv: -kv[1])),
+            "run_s": dict(sorted(self.run_s.items(), key=lambda kv: -kv[1])),
+            "reqs": dict(sorted(self.reqs.items(), key=lambda kv: -kv[1])),
+        }
+        with open(self._path, "a") as f:
+            f.write(self._json.dumps(line) + "\n")
+
+
