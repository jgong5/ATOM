@@ -0,0 +1,59 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Scoped semantic clock; native execution delegates to Python's real clock."""
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+import time as _native
+from typing import Protocol
+
+
+class ClockProvider(Protocol):
+    def time(self) -> float: ...
+    def time_ns(self) -> int: ...
+    def perf_counter(self) -> float: ...
+    def perf_counter_ns(self) -> int: ...
+    def monotonic(self) -> float: ...
+    def monotonic_ns(self) -> int: ...
+
+
+_provider: ContextVar[ClockProvider] = ContextVar("aiperf_clock", default=_native)
+
+
+@contextmanager
+def use_clock(provider: ClockProvider) -> Iterator[None]:
+    """Use a matching clock inside this task context and its child tasks.
+
+    A virtual provider requires an event loop on the same timeline. This does
+    not change Python's time module or clocks in unrelated execution contexts.
+    """
+    token = _provider.set(provider)
+    try:
+        yield
+    finally:
+        _provider.reset(token)
+
+
+def time() -> float:
+    return _provider.get().time()
+
+
+def time_ns() -> int:
+    return _provider.get().time_ns()
+
+
+def perf_counter() -> float:
+    return _provider.get().perf_counter()
+
+
+def perf_counter_ns() -> int:
+    return _provider.get().perf_counter_ns()
+
+
+def monotonic() -> float:
+    return _provider.get().monotonic()
+
+
+def monotonic_ns() -> int:
+    return _provider.get().monotonic_ns()
