{
  "extraKnownMarketplaces": {
    "jgong5": {
      "source": {
        "source": "github",
        "repo": "jgong5/skills"
      }
    }
  },
  "enabledPlugins": {
    "agent-team@jgong5": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/auto_lint.py"
          }
        ]
      }
    ]
  }
}
